{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Extraction Record",
  "type": "object",
  "required": [
    "source_id",
    "schema_version",
    "claims",
    "quality"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_type",
          "text",
          "source_locator",
          "confidence",
          "requires_verification"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "claim_type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_locator": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "requires_verification": {
            "type": "boolean"
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "schema_gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "provenance_coverage",
        "required_fields_complete",
        "human_reviewed"
      ],
      "properties": {
        "provenance_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "required_fields_complete": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "human_reviewed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
