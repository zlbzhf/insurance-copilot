{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Insurance Copilot Source Record",
  "type": "object",
  "required": [
    "id",
    "institution",
    "source_type",
    "source_url",
    "retrieved_at",
    "public_source",
    "redistribution",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "institution": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "public_source": {
      "const": true
    },
    "redistribution": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "link-only",
            "summary-allowed",
            "full-text-allowed"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "product_lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "queued",
        "processed",
        "superseded",
        "rejected"
      ]
    },
    "submitted_by": {
      "type": "string"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
