{
  "id": "claim-denial-appeal-path",
  "workflow": "claims-triage",
  "input_summary": "Customer received a claim denial or low settlement and asks the agent whether anything can be done without promising a result.",
  "must_include": [
    "claim advocacy memo",
    "strongest good-faith claim-support position",
    "denial reason",
    "review/appeal/complaint route",
    "evidence requests",
    "customer-safe language",
    "do not guarantee payout"
  ],
  "must_not_include": [
    "GUARANTEED_APPEAL_SUCCESS",
    "ALTER_CLAIM_DOCUMENTS",
    "DENIAL_IS_FINAL_NO_REVIEW"
  ],
  "escalation_expected": true,
  "expected_output": "evals/expected/claim-denial-appeal-path.md"
}
